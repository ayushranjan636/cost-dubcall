# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Google Apps Script web app URL (Deploy → Manage deployments → copy the /exec URL)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Any long random string. Must match SHARED_SECRET in Apps Script → Project Settings → Script Properties.
SHEET_SECRET=replace-with-a-long-random-string
